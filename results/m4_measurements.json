  "measurement4_where_it_breaks": {
    "per_query": [
      {
        "query": "Q17",
        "sql": "SELECT Emp.name\n  FROM Emp\n WHERE Emp.did = 5 AND Emp.region = 'EU'",
        "est_rows": 1,
        "actual_rows": 0,
        "est_cost": 79,
        "io": 80,
        "failed_assumption": "independence of Emp.did and Emp.region",
        "explanation": "Emp.region is a deterministic function of Emp.did (region = REGIONS[did % 5]). The optimizer computes selectivity as sel(did=5) * sel(region=EU) = 1/50 * 1/5 = 1/250 = 0.004, predicting ~40 rows. Actual for did=5 AND region='EU' is 0 (did 5 maps to 'NA', never 'EU'). The independence assumption is false: the two predicates are perfectly correlated.",
        "what_would_fix_it": "A multi-column histogram (joint of did and region) or a correlation statistic (e.g., mutual information or Pearson coefficient) computed in ANALYZE. With correlated stats, the optimizer would know that did=5 implies region='NA', and compute the actual selectivity instead of multiplying marginals."
      },
